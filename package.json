{
  "name": "c-optiforge",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n coordinator,web -c cyan,magenta \"npm run dev -w @c-optiforge/coordinator\" \"npm run dev -w @c-optiforge/web\"",
    "start": "npm run start -w @c-optiforge/coordinator",
    "worker": "npm run start -w @c-optiforge/worker --",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm test -- --run && node --test scripts/*.test.mjs && npm run build",
    "verify:platform": "node scripts/Run-Isolated-Integration.mjs platform",
    "verify:integration": "node scripts/Run-Isolated-Integration.mjs all && node scripts/Run-Isolated-Integration.mjs enrollment && node scripts/Run-Isolated-Integration.mjs reusable",
    "verify:artifacts": "node scripts/Run-Isolated-Integration.mjs artifacts",
    "verify:recovery": "node scripts/Run-Isolated-Integration.mjs leases && node scripts/Run-Isolated-Integration.mjs recovery",
    "verify:phase4": "node scripts/Run-Isolated-Integration.mjs phase4",
    "verify:compute": "node scripts/Run-Isolated-Integration.mjs compute",
    "verify:settings": "node scripts/Run-Isolated-Integration.mjs settings",
    "verify:web": "node scripts/Run-Isolated-Integration.mjs web",
    "verify:browser": "node scripts/Run-Isolated-Integration.mjs browser",
    "verify:android-browser": "node scripts/Run-Isolated-Integration.mjs android-browser",
    "verify:cancellation": "node scripts/Run-Isolated-Integration.mjs cancellation",
    "sandbox:build": "docker build -t gridx-execution:1 infra/sandbox",
    "verify:execution": "node scripts/Run-Isolated-Integration.mjs execution"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
