{
  "name": "c-optiforge",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n coordinator,web -c cyan,magenta \"npm run dev -w @c-optiforge/coordinator\" \"npm run dev -w @c-optiforge/web\"",
    "start": "npm run start -w @c-optiforge/coordinator",
    "worker": "npm run start -w @c-optiforge/worker --",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm test -- --run && node --test scripts/*.test.mjs && npm run build",
    "verify:platform": "node scripts/Run-Isolated-Integration.mjs platform",
    "verify:integration": "node scripts/Run-Isolated-Integration.mjs all",
    "verify:artifacts": "node scripts/Run-Isolated-Integration.mjs artifacts"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
